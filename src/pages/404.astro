---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Lawson" description="Page not found.">
  <header class="article-head">
    <div class="post-meta">Error 404</div>
    <h1>That page doesn't exist.</h1>
  </header>
  <article class="prose">
    <p>The link may be broken or the post may have moved. <a href="/">Head back to the index.</a></p>
  </article>
</Base>
